# Copy to .env — these defaults run the whole demo with no credentials.

NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000

DATABASE_URL=file:./data/housing-agent.db

# Linq Partner API V3 — https://docs.linqapp.com
# LINQ_API_V3_API_KEY is also accepted (it is the SDK's own env var name).
LINQ_API_KEY=
LINQ_FROM_NUMBER=
LINQ_WEBHOOK_SECRET=
LINQ_WEBHOOK_VERSION=2026-02-03
# true = nothing is sent; intended messages are still persisted and logged.
LINQ_DRY_RUN=true

# mock | qasa   (qasa is a boundary only — see docs/QASA_INTEGRATION.md)
HOUSING_PROVIDER=mock
# true = no landlord is contacted; the application is still recorded.
CONTACT_DRY_RUN=true

# mock | anthropic
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=claude-opus-5

# CHANGE BOTH IN PRODUCTION. The app refuses to start with the default in prod.
ACTION_TOKEN_SECRET=replace-with-a-long-random-secret
INTERNAL_JOB_SECRET=replace-with-a-long-random-secret

ALLOWED_SENDERS=
RENEWAL_LEAD_DAYS=30
LOG_LEVEL=info
